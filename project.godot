; Engine configuration file.
; 黑潮行动 / Operation Black Tide
; 开放世界 PvPvE 军事撤离射击 —— 素材来源 POLYGON Military (Unity -> glTF 转换)

config_version=5

[application]

config/name="黑潮行动 Operation Black Tide"
config/description="开放世界 PvPvE 撤离射击。Godot 4.7 + POLYGON Military 转换素材。"
run/main_scene="res://src/ui/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
GameState="*res://src/autoload/game_state.gd"
AssetLib="*res://src/autoload/asset_lib.gd"
Loadout="*res://src/autoload/loadout.gd"
AudioSfx="*res://src/autoload/audio_sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]

textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="trigger"
3d_physics/layer_5="vehicle"
